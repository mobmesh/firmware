diff --git a/src/helpers/ESP32Board.cpp b/src/helpers/ESP32Board.cpp
index e0ca1d0..3b832b9 100644
--- a/src/helpers/ESP32Board.cpp
+++ b/src/helpers/ESP32Board.cpp
@@ -38,10 +38,33 @@ bool ESP32Board::startOTAUpdate(const char* id, char reply[]) {
   return true;
 }
 
+#if defined(WITH_HOTSPOT_OTA)
+#include <helpers/esp32/HotspotOTA.h>
+#include <helpers/TxtDataHelpers.h>   // StrHelper -- there is no standalone StrHelper.h
+
+bool ESP32Board::startOTAUpdateFromURL(const char* url, char reply[]) {
+  HotspotOtaConfig cfg;
+  HotspotOTA::loadConfig(cfg);
+  StrHelper::strncpy(cfg.url, url, sizeof(cfg.url));
+
+  inhibit_sleep = true;
+  bool ok = HotspotOTA::run(cfg, reply);   // owns GPIO47 power-switch sequencing internally
+  if (ok) reboot();                        // doesn't return
+  return ok;
+}
+#else
+bool ESP32Board::startOTAUpdateFromURL(const char* url, char reply[]) {
+  return false; // not supported
+}
+#endif
+
 #else
 bool ESP32Board::startOTAUpdate(const char* id, char reply[]) {
   return false; // not supported
 }
+bool ESP32Board::startOTAUpdateFromURL(const char* url, char reply[]) {
+  return false; // not supported
+}
 #endif
 
 #endif
