diff --git a/src/helpers/esp32/HotspotOTA.cpp b/src/helpers/esp32/HotspotOTA.cpp
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/helpers/esp32/HotspotOTA.cpp
@@ -0,0 +1,314 @@
+#include "HotspotOTA.h"
+#include <WiFi.h>
+#include <HTTPClient.h>
+#include <Update.h>
+#include <SPIFFS.h>
+#include <mbedtls/sha256.h>
+#include <Utils.h>                    // mesh::Utils::fromHex
+#include <helpers/TxtDataHelpers.h>   // StrHelper -- there is no standalone StrHelper.h; the class
+                                       // lives here (confirmed against how CommonCLI.cpp reaches it)
+
+// The hotspot's WiFi network can take up to ~60s to appear after GPIO47 is asserted (cellular modem
+// boot time). These constants give 6 attempts at 15s each, with a 5s pause between attempts, for a
+// worst-case total budget of 6*15000 + 5*5000 = 115000ms (~1m55s) before giving up -- comfortably
+// past the ~60s worst-case network-appearance time, so an attempt starting after the network is up
+// still gets its full 15s to associate and get a DHCP lease.
+#define OTA_WIFI_JOIN_ATTEMPT_TIMEOUT_MS   15000
+#define OTA_WIFI_JOIN_RETRY_DELAY_MS        5000
+#define OTA_WIFI_JOIN_MAX_ATTEMPTS             6
+#define OTA_HTTP_TIMEOUT_MS                20000
+
+// WAN reachability check, run once WiFi association succeeds. Advisory only -- see checkWanConnectivity()
+// below. 3 attempts (1 initial + 2 retries), 10s apart: accounts for cellular modems commonly showing
+// WiFi association (L2 link) up before the actual data session (PDP context/NAT) has finished negotiating.
+#define OTA_WAN_CHECK_ATTEMPTS                 3
+#define OTA_WAN_CHECK_RETRY_DELAY_MS       10000
+#define OTA_WAN_CHECK_HOST       "google.com"   // stable, near-100%-uptime anchor -- deliberately NOT the
+                                                 // target firmware host, so a WAN-down failure and a
+                                                 // target-specific failure can be told apart (see below)
+
+#define PIN_HOTSPOT_PWR   47   // GPIO47, confirmed clean on Heltec V4.3.1 (GPIO48 = fallback)
+
+// GPIO38 (formerly used here) is PIN_GPS_RX -- confirmed by variants/heltec_v4/platformio.ini and
+// EnvironmentSensorManager.cpp's Serial1.setPins() call -- with no onboard WS2812/NeoPixel anywhere
+// on this board's data lines. That claim traced back to an unverified assumption, not the actual
+// schematic; it explained the earlier "OK reply, no light" hardware reports exactly: rmtInit() and
+// rmtWriteBlocking() both succeeded because the RMT peripheral doesn't know or care that nothing
+// addressable is wired to GPIO38.
+//
+// The one LED this board's own driver confirms exists is P_LORA_TX_LED (GPIO35, per
+// variants/heltec_v4/platformio.ini), already pinMode(OUTPUT)'d by ESP32Board::begin() and normally
+// toggled by HeltecV4Board::onBeforeTransmit()/onAfterTransmit() to show LoRa TX activity. It's a
+// plain single-color LED (no WS2812 driver involved), so status here is conveyed via blink count and
+// hold duration instead of color. Reusing it is safe: run() blocks the main loop for its entire
+// duration, so there's no concurrent LoRa TX to contend with it.
+#define OTA_LED_HOLD_MS   2000   // how long the final success/fail indication stays lit before being
+                                  // turned off, long enough to actually be seen, short enough not to
+                                  // meaningfully delay an already ~2-minute operation
+
+// P_LORA_TX_LED is guaranteed defined here: HotspotOTA.cpp is only ever added to build_src_filter for
+// heltec_v4 environments (see variants/heltec_v4/platformio.ini), and Heltec_lora32_v4's build_flags
+// always set P_LORA_TX_LED=35.
+static void ledBlink(int times, uint32_t on_ms, uint32_t off_ms) {
+  for (int i = 0; i < times; i++) {
+    digitalWrite(P_LORA_TX_LED, HIGH);
+    delay(on_ms);
+    digitalWrite(P_LORA_TX_LED, LOW);
+    if (i < times - 1) delay(off_ms);
+  }
+}
+
+// Shared terminal-failure sequence: a fast, unmistakably-different blink burst -- so a failed update
+// never leaves the LED stuck on, and never gets mistaken for a slower in-progress count. Every failure
+// exit in run() below calls this, regardless of which specific error occurred (WiFi join, hash
+// resolution, HTTP, flash write, or hash mismatch); `reply[]` already carries the specific error text
+// by the time this runs, this is purely the visual.
+static void ledFail() {
+  ledBlink(5, 80, 80);
+}
+
+static bool joinWifiStation(const char* ssid, const char* pwd, char reply[]) {
+  WiFi.mode(WIFI_STA);
+  for (int attempt = 0; attempt < OTA_WIFI_JOIN_MAX_ATTEMPTS; attempt++) {
+    WiFi.begin(ssid, pwd);
+    uint32_t start = millis();
+    while (WiFi.status() != WL_CONNECTED && millis() - start < OTA_WIFI_JOIN_ATTEMPT_TIMEOUT_MS) {
+      delay(250);
+    }
+    if (WiFi.status() == WL_CONNECTED) return true;
+    WiFi.disconnect(true);
+    if (attempt < OTA_WIFI_JOIN_MAX_ATTEMPTS - 1) {
+      delay(OTA_WIFI_JOIN_RETRY_DELAY_MS);   // give the hotspot more time to fully come up
+                                              // before hammering it with another association attempt
+    }
+  }
+  strcpy(reply, "ERR: could not join hotspot WiFi");
+  return false;   // caller (HotspotOTA::run) drops GPIO47 immediately on this return
+}
+
+// Advisory only -- does NOT gate the update. A false result never aborts run() by itself; it's only
+// consulted afterward to pick a more specific error message if a later network step also fails,
+// distinguishing "WAN is down" from "WAN is fine, this specific host/URL has a problem" -- today those
+// collapse into the same generic HTTPClient error. Deliberately targets a stable third-party host
+// (OTA_WAN_CHECK_HOST) rather than the firmware URL's own host, so a problem specific to the firmware
+// host doesn't get misreported as "no WAN".
+static bool checkWanConnectivity() {
+  IPAddress ip;
+  for (int attempt = 0; attempt < OTA_WAN_CHECK_ATTEMPTS; attempt++) {
+    if (WiFi.hostByName(OTA_WAN_CHECK_HOST, ip)) return true;
+    if (attempt < OTA_WAN_CHECK_ATTEMPTS - 1) delay(OTA_WAN_CHECK_RETRY_DELAY_MS);
+  }
+  return false;
+}
+
+// Resolves the expected SHA-256 for cfg.url. Precedence: a manually-set hash (`set ota.sha256`) is the
+// source of truth whenever present -- it is NOT overridden by a sidecar fetch, since the sidecar travels
+// over the same unauthenticated HTTP connection as the firmware itself and offers no independent guarantee.
+// The "<url>.sha256" sidecar fetch (over local WiFi, not the LoRa CLI path) is used only when no manual
+// hash is set.
+static bool resolveExpectedHash(const char* url, const char* manual_hex, uint8_t expect[32], char reply[]) {
+  if (manual_hex[0] != 0) {
+    return mesh::Utils::fromHex(expect, 32, manual_hex);
+  }
+
+  char sidecar_url[160];
+  snprintf(sidecar_url, sizeof(sidecar_url), "%s.sha256", url);
+
+  HTTPClient sidecar_http;
+  if (sidecar_http.begin(sidecar_url) && sidecar_http.GET() == HTTP_CODE_OK) {
+    String hex = sidecar_http.getString();
+    hex.trim();
+    sidecar_http.end();
+    if (hex.length() == 64 && mesh::Utils::fromHex(expect, 32, hex.c_str())) {
+      return true;
+    }
+  } else {
+    sidecar_http.end();
+  }
+
+  strcpy(reply, "ERR: no ota.sha256 set and no .sha256 sidecar found");
+  return false;
+}
+
+bool HotspotOTA::run(const HotspotOtaConfig& cfg, char reply[]) {
+  if (cfg.ssid[0] == 0 || cfg.url[0] == 0) {
+    strcpy(reply, "ERR: ota.wifi/ota.url not configured");
+    return false;
+  }
+
+  pinMode(PIN_HOTSPOT_PWR, OUTPUT);
+  digitalWrite(PIN_HOTSPOT_PWR, HIGH);   // must stay HIGH for the whole network phase --
+                                          // TPS22995-class load switches are not latches
+
+  ledBlink(1, 150, 150);   // 1 blink -- joining WiFi
+
+  if (!joinWifiStation(cfg.ssid, cfg.password, reply)) {
+    digitalWrite(PIN_HOTSPOT_PWR, LOW);
+    ledFail();
+    return false;
+  }
+
+  ledBlink(2, 150, 150);   // 2 blinks -- WiFi joined
+
+  // Advisory only -- see checkWanConnectivity(). Does not gate anything below; run() proceeds
+  // identically regardless of the result. Only consulted to pick a more specific error message if
+  // resolveExpectedHash() or the main HTTP GET also fail.
+  bool wan_ok = checkWanConnectivity();
+
+  uint8_t expect[32];
+  if (!resolveExpectedHash(cfg.url, cfg.sha256_hex, expect, reply)) {
+    if (!wan_ok) strcpy(reply, "ERR: WiFi joined but no WAN connectivity");
+    digitalWrite(PIN_HOTSPOT_PWR, LOW);
+    WiFi.disconnect(true);
+    ledFail();
+    return false;
+  }
+
+  HTTPClient http;
+  http.setTimeout(OTA_HTTP_TIMEOUT_MS);
+  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);   // GitHub release URLs 302 to a
+                                                              // presigned release-assets.githubusercontent.com
+                                                              // link -- without this the GET below returns
+                                                              // 302, not the firmware bytes
+  if (!http.begin(cfg.url)) {
+    strcpy(reply, "ERR: could not open URL");
+    digitalWrite(PIN_HOTSPOT_PWR, LOW);
+    WiFi.disconnect(true);
+    ledFail();
+    return false;
+  }
+
+  int code = http.GET();
+  if (code != HTTP_CODE_OK) {
+    if (!wan_ok) {
+      strcpy(reply, "ERR: WiFi joined but no WAN connectivity");
+    } else {
+      sprintf(reply, "ERR: HTTP GET failed (%d)", code);
+    }
+    http.end();
+    digitalWrite(PIN_HOTSPOT_PWR, LOW);
+    WiFi.disconnect(true);
+    ledFail();
+    return false;
+  }
+
+  int len = http.getSize();   // -1 if server didn't send Content-Length
+  if (!Update.begin(len > 0 ? (size_t)len : UPDATE_SIZE_UNKNOWN, U_FLASH)) {
+    strcpy(reply, "ERR: Update.begin failed");
+    http.end();
+    digitalWrite(PIN_HOTSPOT_PWR, LOW);
+    WiFi.disconnect(true);
+    ledFail();
+    return false;
+  }
+
+  ledBlink(3, 150, 150);   // 3 blinks -- downloading
+
+  mbedtls_sha256_context sha_ctx;
+  mbedtls_sha256_init(&sha_ctx);
+  mbedtls_sha256_starts(&sha_ctx, 0);
+
+  WiFiClient* stream = http.getStreamPtr();
+  uint8_t buf[1024];
+  int written = 0;
+  while (http.connected() && (len < 0 || written < len)) {
+    size_t avail = stream->available();
+    if (!avail) { delay(1); continue; }
+    int n = stream->readBytes(buf, min(avail, sizeof(buf)));
+    if (n <= 0) break;
+    if (Update.write(buf, n) != (size_t)n) {
+      strcpy(reply, "ERR: flash write failed");
+      Update.abort();
+      http.end();
+      digitalWrite(PIN_HOTSPOT_PWR, LOW);
+      WiFi.disconnect(true);
+      ledFail();
+      return false;
+    }
+    mbedtls_sha256_update(&sha_ctx, buf, n);
+    written += n;
+  }
+  http.end();
+
+  if (len > 0 && written != len) {
+    strcpy(reply, "ERR: download incomplete");
+    Update.abort();
+    digitalWrite(PIN_HOTSPOT_PWR, LOW);
+    WiFi.disconnect(true);
+    ledFail();
+    return false;
+  }
+
+  uint8_t digest[32];
+  mbedtls_sha256_finish(&sha_ctx, digest);
+  if (memcmp(digest, expect, 32) != 0) {
+    strcpy(reply, "ERR: SHA-256 mismatch");
+    Update.abort();
+    digitalWrite(PIN_HOTSPOT_PWR, LOW);   // no reason to keep the hotspot up once we know it's bad
+    WiFi.disconnect(true);
+    ledFail();
+    return false;
+  }
+
+  digitalWrite(P_LORA_TX_LED, HIGH);   // solid on -- hash passed
+
+  // Hash verified. All bytes are already sitting in the *inactive* OTA partition -- writing them
+  // there as they streamed in cannot corrupt the currently-running firmware, since ESP32's OTA
+  // scheme never touches the active/booting partition until Update.end() flips the pointer. So the
+  // network dependency genuinely ends here: drop hotspot power now, then finalize locally.
+  digitalWrite(PIN_HOTSPOT_PWR, LOW);
+  WiFi.disconnect(true);
+
+  if (!Update.end(true)) {   // local-only from here: validates size/CRC, flips boot partition pointer
+    strcpy(reply, "ERR: Update.end failed");
+    ledFail();
+    return false;
+  }
+
+  delay(OTA_LED_HOLD_MS);
+  digitalWrite(P_LORA_TX_LED, LOW);   // off -- don't leave it lit into the reboot
+
+  strcpy(reply, "OK - rebooting");
+  return true;   // caller reboots
+}
+
+bool HotspotOTA::loadConfig(HotspotOtaConfig& cfg) {
+  memset(&cfg, 0, sizeof(cfg));
+  File f = SPIFFS.open("/ota_hotspot", "r");
+  if (!f) return false;
+  f.read((uint8_t*)&cfg, sizeof(cfg));
+  f.close();
+  return true;
+}
+
+bool HotspotOTA::saveConfig(const HotspotOtaConfig& cfg) {
+  File f = SPIFFS.open("/ota_hotspot", "w");
+  if (!f) return false;
+  f.write((const uint8_t*)&cfg, sizeof(cfg));
+  f.close();
+  return true;
+}
+
+void HotspotOTA::setPower(bool on) {
+  pinMode(PIN_HOTSPOT_PWR, OUTPUT);
+  digitalWrite(PIN_HOTSPOT_PWR, on ? HIGH : LOW);
+}
+
+bool HotspotOTA::getPower() {
+  // No pinMode() call here deliberately -- reading shouldn't have side effects. digitalRead() on
+  // ESP32 reads the actual pin level regardless of current pinMode, including on a pin currently
+  // driven as OUTPUT. On a fresh boot before setPower()/run() has ever touched this pin, this reads
+  // whatever the pin defaults to -- LOW/off given the hardware pulldown recommended in the design notes.
+  return digitalRead(PIN_HOTSPOT_PWR) == HIGH;
+}
+
+// TEMPORARY, test-only -- see `set led on|off`. Drives the real onboard LED (P_LORA_TX_LED, GPIO35)
+// directly with a plain digitalWrite, independent of running an OTA update, so the corrected LED pin
+// can be confirmed on real hardware before this command is removed. No RMT/WS2812 encoding involved
+// here -- unlike the GPIO38 NeoPixel this replaces, P_LORA_TX_LED is a simple single-color LED already
+// pinMode(OUTPUT)'d by ESP32Board::begin().
+bool HotspotOTA::setTestLed(bool on, char reply[]) {
+  digitalWrite(P_LORA_TX_LED, on ? HIGH : LOW);
+  sprintf(reply, "OK - GPIO%d driven %s", P_LORA_TX_LED, on ? "HIGH" : "LOW");
+  return true;
+}
diff --git a/src/helpers/esp32/HotspotOTA.h b/src/helpers/esp32/HotspotOTA.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/helpers/esp32/HotspotOTA.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <Arduino.h>
+
+// Persisted alongside (but separate from) NodePrefs, in its own small file on SPIFFS,
+// so we don't touch the cross-board NodePrefs binary layout.
+struct HotspotOtaConfig {
+  // Set once via `set ota.wifi`, then persists across every future OTA (same SPIFFS
+  // guarantee that already protects NodePrefs and the node's identity).
+  char ssid[32];
+  char password[64];
+  // Supplied fresh with each `start ota url` command; tied to a specific firmware
+  // image, not a credential.
+  char url[128];
+  char sha256_hex[65];   // source of truth once set via `set ota.sha256`; NOT overridden by a sidecar
+                          // fetch. `set ota.sha256 clear` empties this to fall back to sidecar-fetch.
+};
+
+namespace HotspotOTA {
+  bool loadConfig(HotspotOtaConfig& cfg);                 // reads /ota_hotspot
+  bool saveConfig(const HotspotOtaConfig& cfg);            // writes /ota_hotspot
+
+  // Joins WiFi as a station, GETs cfg.url, streams into Update.*, reboots on success.
+  // Returns false (and fills reply[]) on any failure; does NOT reboot on failure.
+  bool run(const HotspotOtaConfig& cfg, char reply[]);
+
+  // Manual, direct control of the GPIO47 hotspot power switch, entirely independent of run().
+  // Diagnostic/recovery only -- see `set ota.pwr <on|off>` / `get ota.pwr`.
+  void setPower(bool on);
+  bool getPower();
+
+  // TEMPORARY, test-only -- see `set led on|off`. Drives the real onboard LED (P_LORA_TX_LED,
+  // GPIO35) directly, independent of actually running an OTA update, so it can be confirmed on real
+  // hardware. Not meant to ship -- remove once confirmed working.
+  bool setTestLed(bool on, char reply[]);
+}
