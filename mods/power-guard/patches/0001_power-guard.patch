diff --git a/src/helpers/ModHooks.cpp b/src/helpers/ModHooks.cpp
index 90710e4d..8aa61af6 100644
--- a/src/helpers/ModHooks.cpp
+++ b/src/helpers/ModHooks.cpp
@@ -7,7 +7,94 @@
 #include <helpers/esp32/RollbackGuard.h>
 #endif
 
+#ifdef WITH_POWER_GUARD
+#include <helpers/esp32/PowerGuardPolicy.h>
+PowerGuardPolicy power_guard;   // extern'd by CommonCliMods.cpp
+#endif
+
+#if defined(ESP32) && defined(WITH_POWER_GUARD)
+// Board-specific deep-sleep power-down. A board that ships no PowerGuard.h keeps the
+// stock sleep, which leaves its rails up.
+#ifdef P_LORA_PA_POWER
+#define POWER_GUARD_HAS_POWERDOWN 1
+#include <PowerGuard.h>
+#endif
+#ifndef POWER_GUARD_BACKOFF_MAX_SECS
+#define POWER_GUARD_BACKOFF_MAX_SECS 900
+#endif
+#ifndef POWER_GUARD_BACKOFF_START_SECS
+#define POWER_GUARD_BACKOFF_START_SECS 60
+#endif
+
+// RTC slow memory, not flash -- survives deep sleep and costs no write at low voltage.
+RTC_DATA_ATTR static uint32_t bootPwrCheckMagic;
+RTC_DATA_ATTR static uint32_t bootPwrCheckFails;
+
+// Runs before radio_init(), so the radio is still off and drawing nothing. A pack too
+// weak to survive radio startup would otherwise brown out mid-init and reboot forever.
+static void bootPwrCheck() {
+#ifdef POWER_GUARD_HAS_POWERDOWN
+  // Holds survive the reset by design and upstream's own releases are not enough, so
+  // drop them every call whatever the reset reason -- then every path out of here
+  // leaves the pins usable with no control flow to reason about.
+  powerGuardReleaseHolds();
+#endif
+  if (POWER_GUARD_RESUME_MV == 0) return;   // board states no threshold
+
+  uint16_t mv = board.getBattMilliVolts();
+  if (mv == 0) return;               // no reading (USB-powered, no divider) -- not our call
+
+  if (bootPwrCheckMagic != 0x50575243UL) {   // cold boot, or RTC contents lost
+    bootPwrCheckMagic = 0x50575243UL;
+    bootPwrCheckFails = 0;
+  }
+  if (mv >= POWER_GUARD_RESUME_MV) {
+    bootPwrCheckFails = 0;           // recovered -- next depletion starts responsive again
+    return;
+  }
+
+  // Doubles from the start value up to the ceiling: a transient dip recovers in about
+  // a minute, a real depletion settles onto the ceiling. Corrupt or absent RTC content
+  // lands on the shortest wait, so a bad read costs current and never a stranded node.
+  uint32_t shift = bootPwrCheckFails < 16 ? bootPwrCheckFails : 16;
+  uint32_t secs = (uint32_t)POWER_GUARD_BACKOFF_START_SECS << shift;
+  if (secs > POWER_GUARD_BACKOFF_MAX_SECS) secs = POWER_GUARD_BACKOFF_MAX_SECS;
+  bootPwrCheckFails++;
+
+  Serial.printf("batt %umV below %umV -- deep sleep %us (retry %u)\n",
+                mv, (unsigned)POWER_GUARD_RESUME_MV, (unsigned)secs,
+                (unsigned)bootPwrCheckFails);
+  Serial.flush();
+#ifdef POWER_GUARD_HAS_POWERDOWN
+  powerGuardDownPreRadio();
+#endif
+  board.enterDeepSleep((uint32_t)secs);        // powers the radio off; does not return
+}
+#endif
+
+#if defined(ESP32) && defined(WITH_POWER_GUARD)
+#include <esp_system.h>
+#ifndef POWER_GUARD_CLOCK_FALLBACK_EPOCH
+#define POWER_GUARD_CLOCK_FALLBACK_EPOCH 1715770351UL   // same baseline a power-on reset uses
+#endif
+
+// A brownout can leave the RTC holding garbage, and nothing moves a clock backwards,
+// so without this a corrupt value stands until NTP or someone pulls the battery.
+static void bootClockGuard() {
+  if (esp_reset_reason() != ESP_RST_BROWNOUT) return;
+  uint32_t now = rtc_clock.getCurrentTime();
+  if (now == POWER_GUARD_CLOCK_FALLBACK_EPOCH) return;
+  Serial.printf("brownout reset -- clock %u rebased to %u\n",
+                (unsigned)now, (unsigned)POWER_GUARD_CLOCK_FALLBACK_EPOCH);
+  rtc_clock.setCurrentTime(POWER_GUARD_CLOCK_FALLBACK_EPOCH);
+}
+#endif
+
 bool modRadioInit(const char* build_id) {
+#if defined(ESP32) && defined(WITH_POWER_GUARD)
+  bootClockGuard();
+  bootPwrCheck();
+#endif
 #if defined(ESP32) && defined(WITH_OTA_ROLLBACK_GUARD)
   SPIFFS.begin(true);   // RollbackGuard's failure counter needs it mounted before use; safe to call twice
 
@@ -32,10 +119,17 @@ void modLoop() {
 #if defined(ESP32) && defined(WITH_OTA_ROLLBACK_GUARD)
   RollbackGuard::poll();
 #endif
+#ifdef WITH_POWER_GUARD
+  power_guard.loop();
+#endif
 }
 
 bool modWantsPowerSaving() {
+#ifdef WITH_POWER_GUARD
+  return power_guard.isActive();   // runtime only; NodePrefs is never written
+#else
   return false;
+#endif
 }
 
 // Reached through the concrete `board`, not a mesh::MainBoard*, so a virtual that
diff --git a/src/helpers/esp32/CommonCliMods.cpp b/src/helpers/esp32/CommonCliMods.cpp
index 66d77a48..00fd63ea 100644
--- a/src/helpers/esp32/CommonCliMods.cpp
+++ b/src/helpers/esp32/CommonCliMods.cpp
@@ -21,7 +21,100 @@
 #define OTA_MOD_BUILD_DATE "unknown"
 #endif
 
+#if defined(ESP_PLATFORM) && defined(WITH_POWER_GUARD)
+#include <helpers/esp32/PowerGuardPolicy.h>
+extern PowerGuardPolicy power_guard;
+// Board-specific rail power-down, where the board ships one. The radio is already
+// initialised on this path, so enterDeepSleep()'s own powerOff() sleeps the SX1262 --
+// only the rails are left to drop.
+#ifdef P_LORA_PA_POWER
+#define POWER_GUARD_HAS_POWERDOWN 1
+#include <PowerGuard.h>
+#endif
+#ifndef POWER_GUARD_POWEROFF_MIN_SECS
+#define POWER_GUARD_POWEROFF_MIN_SECS 60
+#endif
+#ifndef POWER_GUARD_POWEROFF_MAX_SECS
+#define POWER_GUARD_POWEROFF_MAX_SECS 86400
+#endif
+#endif
+
 bool CommonCLI::handleModCommand(uint32_t sender_timestamp, char* command, char* reply) {
+#if defined(ESP_PLATFORM) && defined(WITH_POWER_GUARD)
+  // Claimed ahead of upstream's 11-char "powersaving" prefix, which would answer
+  // any of these as a status query and look like it worked.
+  if (memcmp(command, "powersaving safe.mv ", 20) == 0) {
+    uint32_t mv = (uint32_t) atol(command + 20);
+    if (!power_guard.setSleepMilliVolts((uint16_t) mv)) {
+      sprintf(reply, "ERR: %u-%u or 0", (unsigned)POWER_GUARD_SAFE_FLOOR_MV,
+              (unsigned)POWER_GUARD_SAFE_MAX_MV);
+    } else if (mv == 0) {
+      strcpy(reply, "OK - safe.mv 0 (rung disabled)");
+    } else {
+      sprintf(reply, "OK - safe.mv %umV%s", (unsigned)mv,
+              power_guard.safeEnabled() ? "" : " (safe is off)");
+    }
+    return true;
+  }
+  if (memcmp(command, "powersaving safe", 16) == 0
+      && (command[16] == 0 || command[16] == ' ')) {
+    const char* arg = (command[16] == ' ') ? command + 17 : "";
+    if (*arg == 0) {
+      sprintf(reply, "safe %s, %umV, batt %umV", power_guard.safeEnabled() ? "on" : "off",
+              (unsigned)power_guard.sleepMilliVolts(), (unsigned)power_guard.lastMilliVolts());
+    } else if (memcmp(arg, "on", 2) == 0) {
+      if (power_guard.sleepMilliVolts() == 0) {
+        strcpy(reply, "ERR: no threshold -- set powersaving safe.mv first");
+      } else {
+        power_guard.setSafeEnabled(true);
+        sprintf(reply, "OK - safe on, %umV", (unsigned)power_guard.sleepMilliVolts());
+      }
+    } else if (memcmp(arg, "off", 3) == 0) {
+      power_guard.setSafeEnabled(false);
+      sprintf(reply, "OK - safe off (%umV kept)", (unsigned)power_guard.sleepMilliVolts());
+    } else {
+      strcpy(reply, "ERR: usage: powersaving safe [on|off]");
+    }
+    return true;
+  }
+  if (memcmp(command, "powersaving auto", 16) == 0
+      && (command[16] == 0 || command[16] == ' ')) {
+    const char* arg = (command[16] == ' ') ? command + 17 : "";
+    if (*arg == 0) {
+      sprintf(reply, "auto %s, active %s, transitions %u", power_guard.isAuto() ? "on" : "off",
+              power_guard.isActive() ? "yes" : "no", (unsigned)power_guard.transitionCount());
+    } else if (memcmp(arg, "on", 2) == 0 || memcmp(arg, "off", 3) == 0) {
+      power_guard.setAuto(*arg == 'o' && arg[1] == 'n');
+      sprintf(reply, "OK - auto %s", power_guard.isAuto() ? "on" : "off");
+    } else {
+      strcpy(reply, "ERR: usage: powersaving auto [on|off]");
+    }
+    return true;
+  }
+
+  // Claimed ahead of upstream's own branch, which calls powerOff() -> enterDeepSleep(0)
+  // and never wakes. A node that cannot wake itself needs a site visit.
+  if (memcmp(command, "poweroff", 8) == 0 || memcmp(command, "shutdown", 8) == 0) {
+    const char* arg = command + 8;   // both verbs are 8 chars
+    uint32_t secs = (*arg == ' ') ? (uint32_t) atol(arg + 1) : 0;
+    if (sender_timestamp != 0) {
+      strcpy(reply, "ERR: poweroff is serial-only");
+    } else if (secs < POWER_GUARD_POWEROFF_MIN_SECS || secs > POWER_GUARD_POWEROFF_MAX_SECS) {
+      sprintf(reply, "ERR: usage: poweroff <secs> (%u-%u)",
+              (unsigned)POWER_GUARD_POWEROFF_MIN_SECS, (unsigned)POWER_GUARD_POWEROFF_MAX_SECS);
+    } else {
+      // enterDeepSleep() never returns, so reply[] would never be printed -- say it here.
+      Serial.printf("OK - deep sleep %us (%uh%um), then reboots\n",
+                    (unsigned)secs, (unsigned)(secs / 3600), (unsigned)((secs % 3600) / 60));
+      Serial.flush();
+#ifdef POWER_GUARD_HAS_POWERDOWN
+      powerGuardDownPostRadio();
+#endif
+      modBoardDeepSleep(secs);   // does not return
+    }
+    return true;
+  }
+#endif
   if (memcmp(command, "ver", 3) == 0) {
     // Shadows upstream's own `ver` branch, which never runs while this mod is built in.
     sprintf(reply, "%s (%s) + ota (%s)", _callbacks->getFirmwareVer(), _callbacks->getBuildDate(), OTA_MOD_BUILD_DATE);
