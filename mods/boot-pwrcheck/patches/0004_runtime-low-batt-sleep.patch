diff --git a/src/helpers/ModHooks.cpp b/src/helpers/ModHooks.cpp
index ef816e1..5ed8cf3 100644
--- a/src/helpers/ModHooks.cpp
+++ b/src/helpers/ModHooks.cpp
@@ -95,7 +95,42 @@ bool modRadioInit(const char* build_id) {
 #endif
 }
 
+#if defined(ESP32) && defined(WITH_BOOT_PWRCHECK)
+#include <helpers/ArduinoHelpers.h>   // millis_passed()
+#ifndef RUNTIME_SLEEP_MV
+#define RUNTIME_SLEEP_MV 0            // 0 disables the runtime check
+#endif
+#ifndef RUNTIME_SLEEP_CHECK_SECS
+#define RUNTIME_SLEEP_CHECK_SECS 30
+#endif
+#ifndef RUNTIME_SLEEP_CONSECUTIVE
+#define RUNTIME_SLEEP_CONSECUTIVE 4
+#endif
+
+// A transmit dips the rail for well under a second, so a 30s sampler rarely lands on
+// one and four in a row will not happen -- that is what keeps adverts from sleeping us.
+static void runtimeSleepCheck() {
+  if (RUNTIME_SLEEP_MV == 0) return;
+  static unsigned long next_check = 0;
+  static uint8_t lows = 0;
+  if (!millis_passed(next_check)) return;
+  next_check = millis() + RUNTIME_SLEEP_CHECK_SECS * 1000UL;
+
+  uint16_t mv = board.getBattMilliVolts();
+  if (mv == 0 || mv >= RUNTIME_SLEEP_MV) { lows = 0; return; }
+  if (++lows < RUNTIME_SLEEP_CONSECUTIVE) return;
+
+  Serial.printf("batt %umV below %umV for %us -- leaving service\n",
+                mv, (unsigned)RUNTIME_SLEEP_MV,
+                (unsigned)(RUNTIME_SLEEP_CHECK_SECS * RUNTIME_SLEEP_CONSECUTIVE));
+  board.enterDeepSleep(BOOT_PWRCHECK_BACKOFF[0]);   // boot check owns the backoff from here
+}
+#endif
+
 void modLoop() {
+#if defined(ESP32) && defined(WITH_BOOT_PWRCHECK)
+  runtimeSleepCheck();
+#endif
 #if defined(ESP32) && defined(WITH_OTA_ROLLBACK_GUARD)
   RollbackGuard::poll();
 #endif
