--- a/src/helpers/ModHooks.cpp
+++ b/src/helpers/ModHooks.cpp
@@ -52,8 +52,27 @@ static void bootPwrCheck() {
 }
 #endif
 
+#if defined(ESP32) && defined(WITH_BOOT_PWRCHECK)
+#include <esp_system.h>
+#ifndef BOOT_CLOCK_FALLBACK_EPOCH
+#define BOOT_CLOCK_FALLBACK_EPOCH 1715770351UL   // same baseline a power-on reset uses
+#endif
+
+// A brownout can leave the RTC holding garbage, and nothing moves a clock backwards,
+// so without this a corrupt value stands until NTP or someone pulls the battery.
+static void bootClockGuard() {
+  if (esp_reset_reason() != ESP_RST_BROWNOUT) return;
+  uint32_t now = rtc_clock.getCurrentTime();
+  if (now == BOOT_CLOCK_FALLBACK_EPOCH) return;
+  Serial.printf("brownout reset -- clock %u rebased to %u\n",
+                (unsigned)now, (unsigned)BOOT_CLOCK_FALLBACK_EPOCH);
+  rtc_clock.setCurrentTime(BOOT_CLOCK_FALLBACK_EPOCH);
+}
+#endif
+
 bool modRadioInit(const char* build_id) {
 #if defined(ESP32) && defined(WITH_BOOT_PWRCHECK)
+  bootClockGuard();
   bootPwrCheck();
 #endif
 #if defined(ESP32) && defined(WITH_OTA_ROLLBACK_GUARD)
