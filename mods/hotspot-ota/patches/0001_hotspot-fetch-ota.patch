 bool modRadioInit(const char* build_id) {
+#if defined(ESP32) && defined(WITH_OTA_ROLLBACK_GUARD)
+  SPIFFS.begin(true);   // RollbackGuard's failure counter needs it mounted before use; safe to call twice
+
+  // A few immediate retries catch a transient glitch before falling back to onRadioInitFailure()'s
+  // cross-boot retry-with-cap.
+  for (int attempt = 0; attempt < 3; attempt++) {
+    if (radio_init()) {
+      RollbackGuard::begin(build_id);
+      return true;
+    }
+    delay(500);
+  }
+  MESH_DEBUG_PRINTLN("Radio init failed!");
+  RollbackGuard::onRadioInitFailure();   // does not return
+  return false;
+#else
   return radio_init();
+#endif
 }
 
 void modLoop() {
+#if defined(ESP32) && defined(WITH_OTA_ROLLBACK_GUARD)
+  RollbackGuard::poll();
+#endif
 }
 
