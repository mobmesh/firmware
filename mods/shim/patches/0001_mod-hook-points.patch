+++ b/examples/simple_repeater/MyMesh.cpp
@@ -1,6 +1,30 @@
 #include "MyMesh.h"
+#include <helpers/ModHooks.h>
 #include <algorithm>
 
+// Reverse hooks that need MyMesh's own members: ModHooks.cpp sees neither _cli nor the tempradio
+// timers, and MyMesh.h carries no patch, so state is snapshotted here instead of exposed.
+static CommonCLI* mod_cli_ref = nullptr;
+
+static struct {
+  float freq, bw;
+  uint8_t sf, cr;
+  bool live;
+} mod_temp_radio;
+
+void modCliDispatch(uint32_t sender_timestamp, char* command, char* reply) {
+  if (mod_cli_ref) mod_cli_ref->handleCommand(sender_timestamp, command, reply);
+}
+
+bool modTempRadioGet(float* freq, float* bw, uint8_t* sf, uint8_t* cr) {
+  if (!mod_temp_radio.live) return false;
+  *freq = mod_temp_radio.freq;
+  *bw = mod_temp_radio.bw;
+  *sf = mod_temp_radio.sf;
+  *cr = mod_temp_radio.cr;
+  return true;
+}
+
 /* ------------------------------ Config -------------------------------- */
 
 #ifndef LORA_FREQ
