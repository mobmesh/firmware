   next_local_advert = next_flood_advert = 0;
   dirty_contacts_expiry = 0;
   set_radio_at = revert_radio_at = 0;
+  mod_cli_ref = &_cli;
   _logging = false;
   region_load_active = false;
   recv_pkt_region = NULL;
@@ -1280,6 +1305,14 @@ void MyMesh::handleCommand(uint32_t sender_timestamp, char *command, char *reply
       strcpy(reply, "OK - Discover sent");
     }
   } else{
+    // Liveness is decided here, where the timers are in scope: pending_* are untested before
+    // the 2s apply and stale after the revert, which clears only the timer.
+    mod_temp_radio = { pending_freq, pending_bw, pending_sf, pending_cr,
+                       set_radio_at == 0 && revert_radio_at != 0
+                         && !millisHasNowPassed(revert_radio_at) };
+    // Mods first: this is the only call site both the release tag and dev spell the same way.
+    if (modHandleCliCommand(sender_timestamp, command, reply,
+                            FIRMWARE_VERSION, FIRMWARE_BUILD_DATE)) return;
     _cli.handleCommand(sender_timestamp, command, reply);  // common CLI commands
   }
 }
