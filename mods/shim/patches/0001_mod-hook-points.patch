diff --git a/src/helpers/ModHooks.h b/src/helpers/ModHooks.h
new file mode 100644
index 0000000..8ab58a9
--- /dev/null
+++ b/src/helpers/ModHooks.h
@@ -0,0 +1,9 @@
+#pragma once
+
+// One hook surface for every mod, so upstream's main.cpp carries a handful of
+// one-line calls instead of each mod's code inline -- and so two mods never
+// have to edit the same region of it. Bodies live in ModHooks.cpp (ours).
+
+bool modRadioInit(const char* build_id);   // wraps upstream's radio_init()
+void modLoop();                            // called first in loop()
+bool modWantsPowerSaving();                // OR'd with the operator's powersaving_enabled
diff --git a/src/helpers/esp32/CommonCliMods.cpp b/src/helpers/esp32/CommonCliMods.cpp
new file mode 100644
index 0000000..26df75c
--- /dev/null
+++ b/src/helpers/esp32/CommonCliMods.cpp
@@ -0,0 +1,16 @@
+// Hook points for mod CLI commands, dispatched ahead of upstream's own chain so a
+// mod can match a longer prefix first. No-ops until a mod fills them in.
+#include <helpers/CommonCLI.h>
+#include <target.h>
+
+bool CommonCLI::handleModCommand(uint32_t sender_timestamp, char* command, char* reply) {
+  return false;
+}
+
+bool CommonCLI::handleModSetCmd(uint32_t sender_timestamp, char* command, char* reply) {
+  return false;
+}
+
+bool CommonCLI::handleModGetCmd(uint32_t sender_timestamp, char* command, char* reply) {
+  return false;
+}
