+void modCliDispatch(uint32_t sender_timestamp, char* command, char* reply) {
+  if (mod_cli_ref) mod_cli_ref->handleCommand(sender_timestamp, command, reply);
+}
+
+bool modPolicyRead(ModPolicyValues* out) {
+  if (out == nullptr || mod_prefs_ref == nullptr) return false;
+  out->flood_max = mod_prefs_ref->flood_max;
+  out->flood_max_unscoped = mod_prefs_ref->flood_max_unscoped;
+  out->flood_max_advert = mod_prefs_ref->flood_max_advert;
