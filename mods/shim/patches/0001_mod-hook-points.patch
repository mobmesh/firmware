+  out->loop_detect = mod_prefs_ref->loop_detect;
+  out->multi_acks = mod_prefs_ref->multi_acks;
+  out->airtime_factor = mod_prefs_ref->airtime_factor;
+  out->tx_delay_factor = mod_prefs_ref->tx_delay_factor;
+  out->agc_reset_interval = mod_prefs_ref->agc_reset_interval;
+  return true;
+}
+
+bool modResolveRegionName(const char* name, ModRegionMatch* out) {
+  if (name == nullptr || out == nullptr || mod_region_map_ref == nullptr) return false;
+  memset(out, 0, sizeof(*out));
+  RegionEntry* entry = strcmp(name, "*") == 0
+                     ? &mod_region_map_ref->getWildcard()
+                     : mod_region_map_ref->findByName(name);
+  if (entry == nullptr) return true;
+  if ((entry->flags & REGION_DENY_FLOOD) != 0) {
+    out->state = MOD_REGION_DENY;
+    return true;
+  }
+  out->state = MOD_REGION_ALLOW;
+  if (entry->isWildcard()) return true;
+  TransportKey key;
+  if (mod_region_map_ref->getTransportKeysFor(*entry, &key, 1) != 1) return false;
+  memcpy(out->key, key.key, sizeof(out->key));
+  return true;
+}
+
+bool modRegionNameForKey(const uint8_t key[16], char* out, size_t capacity) {
+  if (key == nullptr || out == nullptr || capacity == 0 ||
+      mod_region_map_ref == nullptr) return false;
+  for (int i = 0; i < mod_region_map_ref->getCount(); ++i) {
+    const RegionEntry* entry = mod_region_map_ref->getByIdx(i);
+    if (entry == nullptr || entry->isWildcard()) continue;
+    TransportKey keys[4];
+    int count = mod_region_map_ref->getTransportKeysFor(*entry, keys, 4);
+    bool match = false;
+    for (int k = 0; k < count; ++k) {
+      if (memcmp(keys[k].key, key, 16) == 0) match = true;
+    }
+    if (!match) continue;
+    const char* name = entry->name[0] == '#' ? entry->name + 1 : entry->name;
+    size_t len = strlen(name);
+    if (len + 1 > capacity) return false;
+    memcpy(out, name, len + 1);
+    return true;
+  }
+  return false;
+}
+
+bool modPublisherKey(uint8_t out[32]) {
+  if (out == nullptr || mod_mesh_ref == nullptr) return false;
+  memcpy(out, mod_mesh_ref->getSelfId().pub_key, 32);
+  return true;
+}
+
+bool modSignDetached(const uint8_t* data, size_t len, uint8_t signature[64]) {
+  if (data == nullptr || len == 0 || signature == nullptr ||
+      mod_mesh_ref == nullptr || len > 0x7fffffffu) return false;
+  mod_mesh_ref->getSelfId().sign(signature, data, (int)len);
+  return true;
+}
+
+#ifdef MOD_WITH_TX_HOOKS
+struct ModPendingTx {
+  const mesh::Packet* packet;
+  uint32_t id;
+};
+static ModPendingTx mod_pending_tx[4];
+static uint32_t mod_next_tx_id = 1;
+
+static bool modRememberTx(const mesh::Packet* packet, uint32_t id) {
+  for (uint8_t i = 0; i < 4; ++i) {
+    if (mod_pending_tx[i].packet != nullptr) continue;
+    mod_pending_tx[i].packet = packet;
+    mod_pending_tx[i].id = id;
+    return true;
+  }
+  return false;
+}
+
+static uint32_t modForgetTx(const mesh::Packet* packet) {
+  for (uint8_t i = 0; i < 4; ++i) {
+    if (mod_pending_tx[i].packet != packet) continue;
+    uint32_t id = mod_pending_tx[i].id;
+    mod_pending_tx[i] = {};
+    return id;
+  }
+  return 0;
+}
+#endif
+
+bool modSendGroup(const uint8_t* secret, uint8_t hash, const uint8_t* data,
+                  size_t len, bool scoped, const uint8_t scope_key[16],
+                  uint32_t* packet_id) {
+  if (secret == nullptr || data == nullptr || len == 0 || len > 255 ||
+      mod_mesh_ref == nullptr || (scoped && scope_key == nullptr)) return false;
+  mesh::GroupChannel channel = {};
+  channel.hash[0] = hash;
+  memcpy(channel.secret, secret, sizeof(channel.secret));
+  mesh::Packet* packet = mod_mesh_ref->createGroupDatagram(
+      PAYLOAD_TYPE_GRP_DATA, channel, data, len);
+  if (packet == nullptr) return false;
+  uint32_t id = 0;
+#ifdef MOD_WITH_TX_HOOKS
+  id = mod_next_tx_id++;
+  if (mod_next_tx_id == 0) mod_next_tx_id = 1;
+  if (!modRememberTx(packet, id)) {
+    mod_mesh_ref->releasePacket(packet);
+    return false;
+  }
+#endif
+  uint8_t path_size = mod_prefs_ref == nullptr ? 1 : mod_prefs_ref->path_hash_mode + 1;
+  if (scoped) {
+    TransportKey scope;
+    memcpy(scope.key, scope_key, sizeof(scope.key));
+    mod_mesh_ref->sendFloodScoped(scope, packet, 0, path_size);
+  } else {
+    mod_mesh_ref->sendFlood(packet, 0, path_size);
+  }
+  if (packet_id != nullptr) *packet_id = id;
+  return true;
+}
